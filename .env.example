# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database file path (defaults to ./data/restaurant360.db)
DB_PATH=

# Razorpay Payment Gateway Credentials (optional for live mode; sandbox demo mode runs when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Session & Payment Signing Secret (optional; uses secure random fallback in memory if unset)
APP_SECRET=
